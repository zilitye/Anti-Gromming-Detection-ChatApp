<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ChatApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/macos_accent</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/macos_accent</item>
        <item name="android:statusBarColor">@color/macos_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:colorBackground">@color/primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/macos_accent</item>
        <item name="colorAccent">@color/macos_accent</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/white</item>
    </style>

    <style name="PopupMenuTheme" parent="Theme.AppCompat.Light">
        <item name="android:textColor">@color/black</item>
    </style>

</resources>
